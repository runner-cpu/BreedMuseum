{
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": ["src/**/*.{js,jsx,ts,tsx,css,scss}", "tailwind.config.js"]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "none",
			"correctness": {
				"noUndeclaredDependencies": "error",
				"useHookAtTopLevel": "error"
			},
			"suspicious": {
				"noRedeclare": "error"
			},
			"style": {
				"noCommonJs": "error"
			}
		}
	},
	"formatter": {
		"enabled": false
	},
	"css": {
		"parser": {
			"cssModules": false,
			"allowWrongLineComments": false,
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["tailwind.config.js"],
			"linter": {
				"rules": {
					"style": {
						"noCommonJs": "off"
					}
				}
			}
		}
	]
}
